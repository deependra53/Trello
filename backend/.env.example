NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database
MONGODB_URI=mongodb://indihive:indihive@localhost:27017/indihive?authSource=admin

# Redis (for BullMQ + sockets adapter)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-another-strong-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# CORS (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3004,http://localhost:3000

# Email — defaults to ethereal preview when SMTP_HOST is empty.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<you>@gmail.com,
# SMTP_PASS=<16-char App Password, no spaces> (requires 2-Step Verification).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Leave MAIL_FROM blank to auto-use SMTP_USER. If set, it MUST match SMTP_USER
# (or a verified alias) — Gmail rejects/rewrites a non-matching From.
MAIL_FROM=

# Frontend URL (for email links)
APP_URL=http://localhost:3004

# File uploads — choose provider: cloudinary | s3 | local
UPLOAD_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Logging
LOG_LEVEL=info
